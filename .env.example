# Uso LOCAL. Copie para .env (não vai para o git). Na Vercel, configure em Settings → Environment Variables.

# Senha da tela /admin (obrigatória na Vercel/host público).
# ADMIN_TOKEN=

# Link do JSON da spec do RH Net (precisa da VPN). Também pode ser informado na tela.
# RHNET_SPEC_URL=https://api-rhnet-hml.sci.com.br/docs?api-docs.json

# Com este token (Vercel → Storage → Blob → .env.local), "npm run spec:atualizar"
# grava direto no Blob do site na Vercel em vez da pasta specs/.
# BLOB_READ_WRITE_TOKEN=

# Quem baixa a spec: "servidor" (padrão local/Docker) ou "navegador" (padrão na Vercel).
# SPEC_FETCH_MODE=servidor

# Modo servidor: atualização automática a cada N minutos (0 = desligada).
# SPEC_AUTO_UPDATE_MINUTES=60

# Modo servidor, se a URL exigir login (use UMA):
# RHNET_SPEC_TOKEN=
# RHNET_SPEC_COOKIE=
# RHNET_SPEC_HEADERS={"X-Api-Key":"..."}

# Quantas versões anteriores manter.
# SPEC_HISTORY_LIMIT=10

# Certificado HTTPS interno não reconhecido pelo Node (Windows):
# NODE_OPTIONS=--use-system-ca
