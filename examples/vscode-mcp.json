{
  "inputs": [
    { "type": "promptString", "id": "mcp-token", "description": "Token do MCP das APIs", "password": true }
  ],
  "servers": {
    "apis-time-local": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/src/stdio.js"]
    },
    "apis-time-vercel": {
      "type": "http",
      "url": "https://SEU-PROJETO.vercel.app/mcp",
      "headers": { "Authorization": "Bearer ${input:mcp-token}" }
    }
  }
}
