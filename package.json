{
  "name": "mcp-apis-time",
  "version": "1.0.0",
  "description": "Servidor MCP com as specs OpenAPI do time, para documentação e criação de casos de teste",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcp-apis-time": "src/stdio.js"
  },
  "scripts": {
    "start": "node src/http.js",
    "start:stdio": "node src/stdio.js",
    "dev": "node --watch src/http.js",
    "build": "node scripts/validate-specs.js && node scripts/build-bundle.js",
    "validate": "node scripts/validate-specs.js",
    "inspector": "npx @modelcontextprotocol/inspector node src/stdio.js",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  }
}
